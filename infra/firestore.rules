rules_version = '2';
// Willow: the web app never talks to Firestore directly. All reads and writes go through
// the api (Cloud Run, Admin SDK, which bypasses these rules). Deny every client request.
// If a screen ever needs direct client reads, open the narrowest rule here and note it in docs/DECISIONS.md.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
